# Copier vers .env (jamais commiter .env). Valeurs d'exemple uniquement.
NODE_ENV=development
PORT=3000
# Origines autorisees pour CORS, separees par des virgules (jamais *)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Cle de signature des QR codes : generer avec  openssl rand -hex 32
QR_SIGNING_KEY=change-me-change-me-change-me-change-me
